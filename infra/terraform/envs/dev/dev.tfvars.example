# dev 環境の変数値の雛形。実値を使うときは dev.tfvars にコピーして編集する。
#   cp dev.tfvars.example dev.tfvars
#   terraform plan -var-file=dev.tfvars
# ※ dev.tfvars（拡張子 .tfvars）は .gitignore 済み。秘匿値はここに書かず SSM / Secrets Manager へ。
project_name = "raisechat"
environment  = "dev"
aws_region   = "ap-northeast-1"

# --- network（Step 2）---
vpc_cidr  = "10.0.0.0/16"
azs_count = 2
# NAT Gateway は時間課金。通常は false（validate / 待機中は作らない）。
# 実際にアプリをデプロイして E2E 検証する apply のときだけ true にする。
enable_nat_gateway = false

# --- data（Step 3）---
# RDS / ElastiCache は存在するだけで時間課金される。apply は E2E 検証時のみ・検証後 destroy。
db_instance_class = "db.t4g.micro"
redis_node_type   = "cache.t4g.micro"
# 冗長度は通常 OFF（最小）。E2E で Multi-AZ / レプリカを検証するときだけ引き上げる。
db_multi_az              = false
redis_num_cache_clusters = 1

# --- ecs（Step 4）---
# ALB・Fargate・NAT は存在するだけで時間課金される。apply は E2E 検証時のみ・検証後 destroy。
# private の ECS が ECR/Logs へ出るため、E2E のときは network の enable_nat_gateway=true も併用する。
# certificate_arn 未指定なら HTTP:80 フォールバック。ドメイン/ACM を整備したら 443 終端に切替。
certificate_arn = ""
# Fargate の CPU アーキ。push するイメージのビルド先と一致させる（Apple Silicon は ARM64）。
cpu_architecture = "ARM64"
# container_image 未指定なら ECR の :latest を使う（先に docker push してから apply）。
container_image   = ""
ecs_desired_count = 2
ecs_task_cpu      = 512
ecs_task_memory   = 1024
# S3 バケット名・公開 URL は modules/storage が自動命名（${name_prefix}-storage-<account_id>）。tfvars 指定不要。
# 単一 ALB の同一オリジン配信なら CORS は不要。別オリジンにする場合のみフロントのドメインを渡す。
ws_allowed_origins = ""
invite_base_url    = ""

# --- フロント（Step 5 / ECS ホスト・単一 ALB パスルーティング）---
# default → フロント(3000) / /api・/ws → backend(8080)。同一オリジンなので CORS 不要。
# frontend_container_image 未指定なら frontend ECR の :latest を使う（先に docker push してから apply）。
frontend_container_image = ""
frontend_desired_count   = 2
frontend_task_cpu        = 256
frontend_task_memory     = 512
