# フロントエンド環境変数のサンプル。`.env.local` にコピーして使う。

# REST API のベース URL。
# 空文字のままにすると next.config.mjs の rewrites プロキシ（/api/* → BACKEND_ORIGIN）が使われ、
# ブラウザからは同一オリジン（:3000）に見えるため CORS 不要で開発できる。
# 本番でフロントとバックを別ドメインに分ける場合はバックの公開 URL を設定する。
NEXT_PUBLIC_API_BASE=

# WebSocket(SockJS) のエンドポイント（ブラウザから直接接続）。
NEXT_PUBLIC_WS_BASE=http://localhost:8080

# rewrites プロキシの転送先（next.config.mjs がサーバーサイドで参照）。
BACKEND_ORIGIN=http://localhost:8080
